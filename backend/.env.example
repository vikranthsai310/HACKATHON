# Environment Configuration for HRM Decision System

# ==========================================
# API CONFIGURATION
# ==========================================
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=True

# ==========================================
# LLM CONFIGURATION
# ==========================================
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: OpenAI API key
# OPENAI_API_KEY=your_openai_api_key_here

# LLM Model Configuration
GEMINI_MODEL=gemini-1.5-flash
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# ==========================================
# HRM MODEL CONFIGURATION
# ==========================================
HRM_MODEL_PATH=../HRM-main/models/checkpoints/hrm_v1.pt
HRM_USE_SIMULATION=True
HRM_DEVICE=cpu

# ==========================================
# ACTION EXECUTOR CONFIGURATION
# ==========================================
EXECUTOR_DRY_RUN=True
EXECUTOR_TIMEOUT=30

# ==========================================
# LOGGING CONFIGURATION
# ==========================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ==========================================
# CORS CONFIGURATION
# ==========================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=True

# ==========================================
# DATABASE (Optional - for future phases)
# ==========================================
# DATABASE_URL=postgresql://user:password@localhost:5432/hrm_db

# ==========================================
# SECURITY
# ==========================================
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
